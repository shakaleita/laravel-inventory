{
  "name": "shakaleita/laravel-inventory",
  "type": "project",
  "description": "Inventory management system built with Laravel",
  "require": {"php": "^8.2", "laravel/framework": "^11.0"},
  "require-dev": {"fakerphp/faker": "^1.23", "laravel/pint": "^1.13", "phpunit/phpunit": "^11.0"},
  "autoload": {"psr-4": {"App\\": "app/", "Database\\Factories\\": "database/factories/", "Database\\Seeders\\": "database/seeders/"}},
  "scripts": {"test": "php artisan test", "format": "vendor/bin/pint"},
  "minimum-stability": "stable",
  "prefer-stable": true
}
